@@ -0,0 +1,27 @@
+import re
+
+_THINK_BLOCK_RE = re.compile(r'<think>.*?</think>\s*', re.DOTALL)
+
+
+def extract_action_content(content: str) -> str:
+    """Remove <think>...</think> blocks and return the action-only portion.
+
+    Returns empty string for thinking-only or truncated generations —
+    never falls back to the original reasoning content, which could
+    cause reasoning to be executed as an action by the environment.
+    """
+    if '<think>' in content and '</think>' not in content:
+        return ''
+    action = _THINK_BLOCK_RE.sub('', content).strip()
+    # Strip orphaned opening/closing tags from truncated generations
+    action = action.replace("<think>", "").replace("</think>", "").strip()
+    return action
+
+
+def has_thinking_content(content: str) -> bool:
+    return '<think>' in content and '</think>' in content
+
+
+def merge_reasoning_and_content(reasoning_content: str, content: str) -> str:
+    """Reconstruct the full assistant output from split reasoning/content fields."""
+    return f"<think>\n{reasoning_content}\n</think>\n{content}"
diff --git a/agentevolver/utils/verl09_compat.py b/agentevolver/utils/verl09_compat.py
new file mode 100644
index 0000000..a7d6025
--- /dev/null
+++ b/agentevolver/utils/verl09_compat.py
@@ -0,0 +1,59 @@
+"""verl 0.9 compatibility helpers.
+
+verl 0.9 converts config subtrees into strict dataclasses inside the workers
+(FSDPActorConfig, RolloutConfig, MultiTurnConfig, ...). AgentEvolver extends
+the `actor_rollout_ref.rollout` subtree with its own driver-side keys, which
+the 0.9 dataclasses reject with TypeError.
+
+The driver-side AgentEvolver code keeps reading the ORIGINAL config; only the
+copies handed to verl workers / the LLM server manager are stripped here.
+"""
+
+from copy import deepcopy
+
+from omegaconf import OmegaConf
+
+# Keys read by AgentEvolver driver code only — unknown to verl 0.9 dataclasses.
+AE_ROLLOUT_EXTRA_KEYS = (
+    "context_template",
+    "context_template_train_sp_action",
+    "custom_dataflow_cls",
+    "debug_llm_io",
+    "enable_request_id",
+    "max_env_len",
+    "max_env_worker",
+    "sparse",
+    "use_qwen3",
+)
+AE_MULTI_TURN_EXTRA_KEYS = ("completion_callback", "max_steps")
+AE_ACTOR_EXTRA_KEYS = ("off_cliprange_high",)
+
+
+def strip_ae_extension_keys(actor_rollout_ref_cfg):
+    """Return a deep copy of actor_rollout_ref with AE-only keys removed."""
+    cfg = deepcopy(actor_rollout_ref_cfg)
+    OmegaConf.set_struct(cfg, False)
+    rollout = cfg.get("rollout")
+    if rollout is not None:
+        for k in AE_ROLLOUT_EXTRA_KEYS:
+            rollout.pop(k, None)
+        mt = rollout.get("multi_turn")
+        if mt is not None:
+            for k in AE_MULTI_TURN_EXTRA_KEYS:
+                mt.pop(k, None)
+    actor = cfg.get("actor")
+    if actor is not None:
+        for k in AE_ACTOR_EXTRA_KEYS:
+            actor.pop(k, None)
+    OmegaConf.set_struct(cfg, True)
+    return cfg
+
+
+def strip_ae_extension_keys_full(full_cfg):
+    """Return a deep copy of the FULL trainer config with the
+    actor_rollout_ref subtree stripped of AE-only keys."""
+    cfg = deepcopy(full_cfg)
+    OmegaConf.set_struct(cfg, False)
+    cfg.actor_rollout_ref = strip_ae_extension_keys(cfg.actor_rollout_ref)
+    OmegaConf.set_struct(cfg, True)
+    return cfg
