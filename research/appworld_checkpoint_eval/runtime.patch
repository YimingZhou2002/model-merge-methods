diff --git a/agentevolver/module/context_manager/cmt_linear_tokens.py b/agentevolver/module/context_manager/cmt_linear_tokens.py
new file mode 100644
index 0000000..353f6ee
--- /dev/null
+++ b/agentevolver/module/context_manager/cmt_linear_tokens.py
@@ -0,0 +1,416 @@
+"""Append-only token-ID context manager for Qwen3 thinking/CoT training.
+
+Maintains the full conversation as an append-only list of token IDs.  Uses
+/v1/completions (NOT /v1/chat/completions) so the server receives the EXACT
+token sequence we intend to train on — no template re-application, no
+thinking-stripping, no retokenization of sampled completions.
+
+Training prefix == inference prompt by construction.
+
+Loss mask:
+  - System/user/env headers and observations: 0
+  - Generation prompt (<|im_start|>assistant\\n and <think>\\n): 0
+  - Sampled completion tokens (reasoning + action + <|im_end|>): 1
+"""
+
+import copy
+import torch
+from typing import List, Optional
+
+from agentevolver.module.context_manager.cmt_base import ContextManagerBase, ExtendedMessage
+from agentevolver.module.context_manager.cmt_linear import Linear_CMT
+from agentevolver.schema.trajectory import Sample, Reward, Trajectory
+from agentevolver.utils.thinking import extract_action_content
+from best_logger import print_nested, NestedJsonItem, SeqItem
+
+
+class LinearTokenCMT(Trajectory, ContextManagerBase):
+    """Token-ID append-only context manager.
+
+    ``prepare_next_llm_context`` returns ``List[int]`` (token IDs), not
+    message dicts.  The caller routes them through ``submit_completions``
+    (``/v1/completions``).  Every token in ``self.token_ids`` is either
+    produced by the tokenizer from deterministic text (init/env/headers)
+    or is the verbatim server-returned sampled token ID (completions).
+    """
+
+    def __init__(self, config, tokenizer):
+        super().__init__()
+        self.config = config
+        self.tokenizer = tokenizer
+        self.full_context: List[ExtendedMessage] = []
+
+        max_response_length = config.actor_rollout_ref.rollout.response_length
+        max_model_len: int = config.actor_rollout_ref.rollout.max_model_len
+        self.max_seq_length: int = max_model_len - max_response_length
+
+        # Append-only token sequence (the whole conversation)
+        self.token_ids: List[int] = []
+
+        # Spans of sampled completions within token_ids: (start, end)
+        self._completion_spans: List[tuple] = []
+        # Per-token logprobs parallel to each span
+        self._completion_logprobs: List[List[float]] = []
+        # Server-returned prompt and completion IDs for provenance
+        self._server_prompt_ids: List[Optional[List[int]]] = []
+        self._server_completion_ids: List[List[int]] = []
+
+        # Index where the latest env turn starts (for remove_last_context)
+        self._env_turn_start: Optional[int] = None
+        self._env_ext_msg_appended: bool = False
+
+        # Generation prompt tokens — computed once at first use
+        self._gen_prompt_ids: Optional[List[int]] = None
+
+        # Chat template kwargs for thinking mode
+        self._enable_thinking = True
+        self._chat_template_kwargs = {"enable_thinking": True}
+        self._initial_prefix_length = None
+
+        self.generated_token_cnt = 0
+        self.discarded = False
+        self.is_terminated = False
+        self.reward = None
+        self.llm_output_mistakes = {}
+        self.metadata = {}
+
+    # ------------------------------------------------------------------
+    # Generation prompt
+    # ------------------------------------------------------------------
+    def _compute_gen_prompt_ids(self) -> List[int]:
+        """Compute the generation-prompt token IDs once.
+
+        Uses a dummy conversation so the result is deterministic.
+        """
+        dummy = [{"role": "user", "content": "x"}]
+        without = self.tokenizer.apply_chat_template(
+            dummy, tokenize=False, add_generation_prompt=False)
+        with_gp = self.tokenizer.apply_chat_template(
+            dummy, tokenize=False, add_generation_prompt=True,
+            **self._chat_template_kwargs)
+        ids_without = self.tokenizer(without, add_special_tokens=False)["input_ids"]
+        ids_with = self.tokenizer(with_gp, add_special_tokens=False)["input_ids"]
+        if ids_with[:len(ids_without)] != ids_without:
+            raise ValueError("Generation template is not an append-only extension")
+        return ids_with[len(ids_without):]
+
+    @property
+    def gen_prompt_ids(self) -> List[int]:
+        if self._gen_prompt_ids is None:
+            self._gen_prompt_ids = self._compute_gen_prompt_ids()
+        return self._gen_prompt_ids
+
+    # ------------------------------------------------------------------
+    # Env turn token computation
+    # ------------------------------------------------------------------
+    def _compute_env_turn_ids(self, env_content: str) -> List[int]:
+        """Compute tokens for an env (user) turn WITHOUT generation prompt.
+
+        Uses a template-diff approach with a dummy assistant turn to get
+        the exact token sequence the template would produce for a new user
+        message.
+        """
+        before_msgs = [{"role": "assistant", "content": "X"}]
+        after_msgs = [
+            {"role": "assistant", "content": "X"},
+            {"role": "user", "content": env_content},
+        ]
+        before_text = self.tokenizer.apply_chat_template(
+            before_msgs, tokenize=False, add_generation_prompt=False)
+        after_text = self.tokenizer.apply_chat_template(
+            after_msgs, tokenize=False, add_generation_prompt=False)
+        ids_before = self.tokenizer(before_text, add_special_tokens=False)["input_ids"]
+        ids_after = self.tokenizer(after_text, add_special_tokens=False)["input_ids"]
+        if ids_after[:len(ids_before)] != ids_before:
+            raise ValueError("Environment template is not an append-only extension")
+        return ids_after[len(ids_before):]
+
+    # ------------------------------------------------------------------
+    # CMT interface
+    # ------------------------------------------------------------------
+    def save_init_input(self, init_input_arr: list, add_nothink: bool = False):
+        """Tokenize initial messages with the chat template + generation prompt."""
+        text = self.tokenizer.apply_chat_template(
+            init_input_arr, tokenize=False, add_generation_prompt=True,
+            **self._chat_template_kwargs)
+        self.token_ids = self.tokenizer(text, add_special_tokens=False)["input_ids"]
+        if len(self.token_ids) > self.config.data.max_prompt_length:
+            raise ValueError("Initial prompt exceeds training prompt storage budget")
+        self._initial_prefix_length = len(self.token_ids)
+
+        for msg in init_input_arr:
+            ext_msg = ExtendedMessage(
+                author="initialization",
+                role=msg["role"],
+                content=msg["content"],
+                token_generator="auto",
+                tokenizer=self.tokenizer,
+            )
+            self.full_context.append(ext_msg)
+
+    def prepare_next_llm_context(self):
+        """Return the current token ID sequence as the prompt.
+
+        The caller must detect ``isinstance(result, list)`` and route to
+        ``submit_completions`` instead of ``submit_chat_completions``.
+        """
+        return list(self.token_ids)
+
+    def check_context_token_num_safe(self, prompt_ids) -> bool:
+        if isinstance(prompt_ids, list) and prompt_ids and isinstance(prompt_ids[0], int):
+            limit = min(self.max_seq_length,
+                        self._initial_prefix_length + self.config.data.max_response_length
+                        - self.config.actor_rollout_ref.rollout.response_length)
+            return len(prompt_ids) <= limit
+        return True
+
+    def save_llm_output(self, llm_output: dict, input_msg_ref=None,
+                        auto_register_full_context=True):
+        """Append sampled completion tokens.  Validates provenance."""
+        comp_ids = llm_output.get("completion_token_ids")
+        if comp_ids is None or len(comp_ids) == 0:
+            raise ValueError(
+                "Missing completion_token_ids from /v1/completions response; "
+                "cannot build consistent training sample")
+
+        logprobs = llm_output.get("token_logprobs")
+        if logprobs is None:
+            logprobs_from_tokens = [t.logprob for t in llm_output.get("tokens", [])]
+            if len(logprobs_from_tokens) == len(comp_ids):
+                logprobs = logprobs_from_tokens
+            else:
+                raise ValueError(
+                    f"Logprob count ({len(logprobs_from_tokens)}) != completion "
+                    f"token count ({len(comp_ids)}); rejecting inconsistent provenance")
+
+        # Strict prefix check
+        server_prompt = llm_output.get("prompt_token_ids")
+        if server_prompt is None:
+            raise ValueError("Missing server prompt token provenance")
+        if list(server_prompt) != list(self.token_ids):
+            raise ValueError("Prompt token ID mismatch: server prompt differs from training prefix")
+        if input_msg_ref is not None:
+            sent = list(input_msg_ref)
+            got = list(server_prompt)
+            if sent != got:
+                first_diff = next(
+                    (i for i, (a, b) in enumerate(zip(sent, got)) if a != b),
+                    min(len(sent), len(got)))
+                raise ValueError(
+                    f"Prompt token ID mismatch at position {first_diff}: "
+                    f"sent {len(sent)} tokens, server saw {len(got)}")
+
+        import math
+        if len(logprobs) != len(comp_ids) or any(
+                p is None or not math.isfinite(float(p)) for p in logprobs):
+            raise ValueError("Missing or inconsistent sampled completion logprobs")
+        if any(not isinstance(t, int) or t < 0 for t in comp_ids):
+            raise ValueError("Invalid sampled completion token ID")
+        # Append completion tokens
+        self._env_turn_start = None
+        self._env_ext_msg_appended = False
+        start = len(self.token_ids)
+        self.token_ids.extend(comp_ids)
+        end = len(self.token_ids)
+
+        self._completion_spans.append((start, end))
+        self._completion_logprobs.append(list(logprobs))
+        self._server_prompt_ids.append(
+            list(server_prompt) if server_prompt is not None else None)
+        self._server_completion_ids.append(list(comp_ids))
+
+        self.generated_token_cnt = len(comp_ids)
+
+        # Reconstruct full assistant content for text-level operations
+        raw_decoded = self.tokenizer.decode(comp_ids, skip_special_tokens=False)
+        # Strip trailing <|im_end|> or EOS from text
+        for stop_str in ("<|im_end|>", self.tokenizer.eos_token):
+            if stop_str and raw_decoded.endswith(stop_str):
+                raw_decoded = raw_decoded[:-len(stop_str)]
+                break
+        # The gen prompt included <think>\n; prepend it to get full content
+        full_content = "<think>\n" + raw_decoded if self._enable_thinking else raw_decoded
+        llm_output["_full_content"] = full_content
+        Linear_CMT.influence_extra_reward(self, dict(llm_output, content=full_content))
+
+        if auto_register_full_context:
+            ext_msg = ExtendedMessage(
+                author="llm",
+                role="assistant",
+                content=full_content,
+                token_generator="manual",
+                tokenizer=self.tokenizer,
+            )
+            ext_msg.token_arr = list(comp_ids)
+            self.full_context.append(ext_msg)
+
+        return ext_msg if auto_register_full_context else None
+
+    def save_env_output(self, env_output: dict, input_msg_ref=None,
+                        add_nothink: bool = False):
+        """Tokenize the env turn + next generation prompt and append."""
+        if "content" not in env_output or not env_output["content"]:
+            env_output["content"] = "[No content provided by the environment]"
+
+        ext_msg = ExtendedMessage(
+            author="env",
+            role="user",
+            content=env_output["content"],
+            clip=True,
+            clip_token_limit=self.config.actor_rollout_ref.rollout.max_env_len,
+            token_generator="auto",
+            tokenizer=self.tokenizer,
+        )
+        self._env_turn_start = len(self.token_ids)
+        # Returned completion IDs include a sampled EOS when generation stops;
+        # the message-separating newline belongs to the next masked input.
+        if self.token_ids and self.token_ids[-1] != self.tokenizer.eos_token_id:
+            self.token_ids.append(self.tokenizer.eos_token_id)
+        self.token_ids.extend(self.tokenizer("\n", add_special_tokens=False)["input_ids"])
+        env_turn_ids = self._compute_env_turn_ids(ext_msg.content_for_future)
+        self.token_ids.extend(env_turn_ids)
+        self.token_ids.extend(self.gen_prompt_ids)
+        self.full_context.append(ext_msg)
+        self._env_ext_msg_appended = True
+
+    def prepare_world_interaction(self) -> str:
+        """Return action-only text (thinking stripped) for the environment."""
+        content = self.full_context[-1].content
+        return extract_action_content(content)
+
+    def remove_last_context(self):
+        """Remove the trailing env turn + generation prompt tokens."""
+        if self._env_turn_start is not None:
+            self.token_ids = self.token_ids[:self._env_turn_start]
+            self._env_turn_start = None
+        if self._env_ext_msg_appended and self.full_context and \
+                self.full_context[-1].author != "llm":
+            self.full_context.pop()
+            self._env_ext_msg_appended = False
+
+    # ------------------------------------------------------------------
+    # Training: group_tokenize
+    # ------------------------------------------------------------------
+    def group_tokenize(self) -> List[Sample]:
+        """Build a single training sample from the append-only token history.
+
+        Whole-trajectory approach: one Sample per trajectory.  prompt_ids
+        = everything before the first completion; response_ids = from the
+        first completion to the end.
+        """
+        from verl.utils.model import compute_position_id_with_mask
+
+        if not self._completion_spans:
+            return []
+
+        input_ids = list(self.token_ids)
+        n = len(input_ids)
+
+        # Loss mask: 1 only for completion spans
+        loss_mask = [0] * n
+        sampled_logprobs = [0.0] * n
+        for j, (start, end) in enumerate(self._completion_spans):
+            if input_ids[:start] != self._server_prompt_ids[j]:
+                raise ValueError("Training prefix differs from actual rollout prompt")
+            if input_ids[start:end] != self._server_completion_ids[j]:
+                raise ValueError("Training completion differs from sampled token IDs")
+            if end > n or end - start != len(self._completion_logprobs[j]):
+                raise ValueError("Training sampled-token/logprob span is incomplete")
+            for i in range(start, min(end, n)):
+                loss_mask[i] = 1
+                sampled_logprobs[i] = self._completion_logprobs[j][i - start]
+
+        # Prompt/response split at first completion
+        split_idx = self._completion_spans[0][0]
+        assert split_idx > 0, "First completion cannot start at position 0"
+
+        attention_mask = [1] * n
+        position_ids = compute_position_id_with_mask(
+            torch.tensor(attention_mask)).tolist()
+
+        prompt_ids = input_ids[:split_idx]
+        response_ids = input_ids[split_idx:]
+        if len(prompt_ids) > self.config.data.max_prompt_length or len(response_ids) > self.config.data.max_response_length:
+            raise ValueError("Exact token trajectory exceeds storage budget; refusing truncation")
+
+        sample = Sample(
+            data_id=getattr(self, "data_id", ""),
+            rollout_id=getattr(self, "rollout_id", ""),
+            task_id=getattr(self, "task_id", ""),
+            minor_index_id=0,
+            messages=self._to_role_content(),
+            extras={"rollout_log_probs": sampled_logprobs[split_idx:],
+                    "exact_token_context": True,
+                    "exact_completion_spans": list(self._completion_spans)},
+            input_ids=input_ids,
+            prompt_ids=prompt_ids,
+            response_ids=response_ids,
+            attention_mask=attention_mask,
+            prompt_attention_mask=attention_mask[:split_idx],
+            response_attention_mask=attention_mask[split_idx:],
+            loss_mask=loss_mask,
+            prompt_loss_mask=loss_mask[:split_idx],
+            response_loss_mask=loss_mask[split_idx:],
+            position_ids=position_ids,
+            prompt_position_ids=position_ids[:split_idx],
+            response_position_ids=position_ids[split_idx:],
+            reward_scores=self.reward.model_dump() if self.reward else {},
+            max_prompt_len=self.config.data.max_prompt_length,
+            max_response_len=self.config.data.max_response_length,
+            max_model_len=(self.config.data.max_response_length +
+                           self.config.data.max_prompt_length),
+        )
+        sample.truncate_output_ids()
+        assert len(sample.response_ids) != 0, "response_ids should not be empty"
+        return [sample]
+
+    # ------------------------------------------------------------------
+    # Helpers
+    # ------------------------------------------------------------------
+    def _to_role_content(self) -> List[dict]:
+        return [{"role": m.role, "content": m.content_for_future}
+                for m in self.full_context]
+
+    def to_role_content(self, ext_messages):
+        return [{"role": m.role, "content": m.content_for_future} for m in ext_messages]
+
+    def json(self):
+        import json
+        return json.dumps(self._to_role_content(), ensure_ascii=False)
+
+    @property
+    def steps(self):
+        return self._to_role_content()
+
+    def compute_madness(self) -> float:
+        return Linear_CMT.compute_madness(self)
+
+    def reward_patch(self, _reward):
+        return _reward
+
+    def generate_log(self, task_id):
+        """Generate training visualisation log."""
