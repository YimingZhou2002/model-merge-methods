+        lp = choice.get("logprobs") or {}
+        token_logprobs = lp.get("token_logprobs") or []
+        if len(token_logprobs) != len(completion_token_ids):
+            raise ValueError(
+                f"Logprob count ({len(token_logprobs)}) != completion token "
+                f"count ({len(completion_token_ids)}); rejecting inconsistent "
+                f"provenance")
+
+        import math
+        if any(p is None or not math.isfinite(float(p)) for p in token_logprobs):
+            raise ValueError("Missing or non-finite sampled token logprob")
+        lp_tokens = lp.get("tokens") or []
+        if len(lp_tokens) != len(completion_token_ids) or [
+            int(t.split("token_id:")[-1]) for t in lp_tokens
+        ] != list(completion_token_ids):
+            raise ValueError("Logprob token IDs differ from returned completion IDs")
+        returned_prompt = choice.get("prompt_token_ids")
+        if returned_prompt is None:
+            returned_prompt = data.get("prompt_token_ids")
+        if returned_prompt is None or list(returned_prompt) != list(prompt_token_ids):
+            raise ValueError("Missing or mismatched server prompt token provenance")
+
+        tokens = [
+            TokenAndProb(
+                token_id=tid,
+                logprob=float(lp_val),
+            )
+            for tid, lp_val in zip(completion_token_ids, token_logprobs)
+        ]
+
+        # Decode text for env interaction / logging
+        text = choice.get("text", "")
+        if not text:
+            text = self.tokenizer.decode(
+                completion_token_ids, skip_special_tokens=False)
+
+        finish_reason = choice.get("finish_reason")
+        if finish_reason != "stop":
+            logger.warning(
+                f"vllm completions non-stop: finish_reason={finish_reason}")
+
+        return {
+            "role": "assistant",
+            "content": text,
+            "tokens": tokens,
+            "token_logprobs": token_logprobs,
+            "completion_token_ids": completion_token_ids,
+            "prompt_token_ids": returned_prompt,
+            "finish_reason": finish_reason,
+            "request_id": data.get("id", ""),
+            "completion_tokens": (data.get("usage") or {}).get(
+                "completion_tokens"),
+        }
