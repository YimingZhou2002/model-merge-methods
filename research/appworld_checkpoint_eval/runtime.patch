+# ---------------------------------------------------------------------------
+# 3. Thinking utility functions
+# ---------------------------------------------------------------------------
+
+class TestThinkingUtils:
+
+    def test_extract_strips_think_block(self):
+        content = "<think>\nReason.\n</think>\n```python\ndo_x()\n```"
+        assert "<think>" not in extract_action_content(content)
+        assert "do_x()" in extract_action_content(content)
+
+    def test_extract_thinking_only_returns_empty(self):
+        """Thinking-only generation must return empty, not the reasoning."""
+        content = "<think>\nI should do X but I don't know how.\n</think>"
+        result = extract_action_content(content)
+        assert result == "", f"Expected empty, got: {result!r}"
+
+    def test_extract_truncated_think_returns_empty(self):
+        """Truncated <think> without closing tag must not leak reasoning."""
+        content = "<think>\nPartial reasoning without end"
+        result = extract_action_content(content)
+        assert "Partial reasoning" not in result
+
+    def test_no_think_passthrough(self):
+        assert extract_action_content("plain action") == "plain action"
+
+    def test_merge_no_duplicate_tags(self):
+        merged = merge_reasoning_and_content("reason", "action")
+        assert merged.count("<think>") == 1
+        assert merged.count("</think>") == 1
+
+    def test_extract_is_inverse_of_merge(self):
+        merged = merge_reasoning_and_content("reason", "action here")
+        assert extract_action_content(merged) == "action here"
+
