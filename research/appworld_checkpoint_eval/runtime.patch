+# ---------------------------------------------------------------------------
+# 5. LinearTokenCMT — requires a tokenizer with chat template
+# ---------------------------------------------------------------------------
+
+def _try_load_tokenizer():
+    try:
+        from transformers import AutoTokenizer
+        model_ids = [os.environ.get("COT_TOKENIZER_PATH")]
+        for model_id in filter(None, model_ids):
+            try:
+                tok = AutoTokenizer.from_pretrained(
+                    model_id, trust_remote_code=False, local_files_only=True)
+                if hasattr(tok, "apply_chat_template"):
+                    return tok
+            except Exception:
+                continue
+    except ImportError:
+        pass
+    return None
+
+
+_TOKENIZER = _try_load_tokenizer()
+_skip_no_tokenizer = pytest.mark.skipif(
+    _TOKENIZER is None,
+    reason="No tokenizer with chat_template; run on remote with model access")
+
+
+def _build_mock_config():
+    from omegaconf import OmegaConf
+    return OmegaConf.create({
+        "actor_rollout_ref": {
+            "rollout": {
+                "response_length": 512,
+                "max_model_len": 4096,
+                "max_env_len": 1024,
+                "context_template": "linear_tokens",
+                "multi_turn": {"max_sample_per_task": 10},
+            },
+            "model": {"path": "test"},
+        },
+        "data": {
+            "max_prompt_length": 3072,
+            "max_response_length": 1024,
+        },
+        "env_service": {"env_feedin_preference": "code"},
+        "exp_manager": {"experience_template": "{}"},
+    })
+
+
+@_skip_no_tokenizer
+class TestLinearTokenCMT:
+
+    def _make_cmt(self):
+        from agentevolver.module.context_manager.cmt_linear_tokens import LinearTokenCMT
+        self._cmt_for_fake = LinearTokenCMT(_build_mock_config(), _TOKENIZER)
+        return self._cmt_for_fake
+
+    def _fake_completion(self, text):
+        """Encode text as if it were a completion (tokens after gen prompt)."""
+        ids = _TOKENIZER.encode(text, add_special_tokens=False)
+        lps = [-0.05 * (i + 1) for i in range(len(ids))]
+        from agentevolver.module.trainer.ae_async_llm_server_manager import TokenAndProb
+        tokens = [TokenAndProb(token_id=tid, logprob=lp)
+                  for tid, lp in zip(ids, lps)]
+        return {
+            "role": "assistant",
+            "content": text,
+            "tokens": tokens,
+            "token_logprobs": lps,
+            "completion_token_ids": ids,
+            "prompt_token_ids": list(self._cmt_for_fake.token_ids),
+            "finish_reason": "stop",
+            "request_id": "test",
+        }
+
+    def test_init_tokenizes_with_gen_prompt(self):
+        cmt = self._make_cmt()
+        init = [
+            {"role": "system", "content": "You are helpful."},
+            {"role": "user", "content": "Do the task."},
+        ]
+        cmt.save_init_input(init)
+        assert len(cmt.token_ids) > 0
+        # Should end with generation prompt (contains assistant header)
+        decoded = _TOKENIZER.decode(cmt.token_ids)
+        assert "assistant" in decoded
+
+    def test_prepare_returns_token_ids(self):
+        cmt = self._make_cmt()
+        cmt.save_init_input([{"role": "user", "content": "Go."}])
+        prompt = cmt.prepare_next_llm_context()
+        assert isinstance(prompt, list)
+        assert all(isinstance(x, int) for x in prompt)
+        assert prompt == cmt.token_ids
+
+    def test_second_prompt_equals_training_prefix(self):
+        """Core consistency test: step 2 prompt IDs == training prompt_ids."""
+        cmt = self._make_cmt()
+        init = [{"role": "user", "content": "Solve it."}]
+        cmt.save_init_input(init)
+
+        # Step 1
+        prompt1 = cmt.prepare_next_llm_context()
+        comp1_text = "I need to list files.\n</think>\n```python\nos.listdir('.')\n```<|im_end|>"
+        comp1 = self._fake_completion(comp1_text)
+        cmt.save_llm_output(comp1, input_msg_ref=prompt1)
+        cmt.save_env_output({"role": "user", "content": "['f1.txt', 'f2.txt']"})
+
+        # Step 2
+        prompt2 = cmt.prepare_next_llm_context()
+
+        comp2_text = "Read f1.txt now.\n</think>\n```python\nopen('f1.txt').read()\n```<|im_end|>"
+        comp2 = self._fake_completion(comp2_text)
+        cmt.save_llm_output(comp2, input_msg_ref=prompt2)
+
+        # Remove trailing env (simulates agent_flow.remove_last_context)
+        # In this test there's no trailing env after step 2's completion
+        cmt.remove_last_context()
+
+        samples = cmt.group_tokenize()
+        assert len(samples) == 1
+        sample = samples[0]
+
+        # Training prompt = everything before first completion
+        # Step 2's prompt = prompt2 (token IDs sent to the model)
+        # The first completion_span starts at len(prompt1)
+        first_span_start = cmt._completion_spans[0][0]
+        training_prefix = sample.input_ids[:first_span_start]
+
+        assert training_prefix == prompt1, (
+            f"Training prefix ({len(training_prefix)} tokens) != "
+            f"step 1 prompt ({len(prompt1)} tokens)")
+
+        # Check that step 2's prompt is fully contained in input_ids
+        second_span_start = cmt._completion_spans[1][0]
+        training_prefix_step2 = sample.input_ids[:second_span_start]
+        assert training_prefix_step2 == prompt2, (
+            f"Training prefix before step 2 ({len(training_prefix_step2)}) != "
+            f"step 2 prompt ({len(prompt2)})")
+
+    def test_loss_mask_completions_only(self):
+        """Loss mask must be 1 only for completion spans."""
+        cmt = self._make_cmt()
+        cmt.save_init_input([{"role": "user", "content": "Go."}])
+
+        prompt1 = cmt.prepare_next_llm_context()
+        comp1 = self._fake_completion("thought\n</think>\naction1<|im_end|>")
+        cmt.save_llm_output(comp1, input_msg_ref=prompt1)
+        cmt.save_env_output({"role": "user", "content": "result"})
+
+        prompt2 = cmt.prepare_next_llm_context()
+        comp2 = self._fake_completion("thought2\n</think>\naction2<|im_end|>")
+        cmt.save_llm_output(comp2, input_msg_ref=prompt2)
+        cmt.remove_last_context()
+
+        samples = cmt.group_tokenize()
+        sample = samples[0]
+
+        # Check: prompt portion has all-zero loss mask
+        assert all(m == 0 for m in sample.prompt_loss_mask)
+
+        # Check: in response portion, only completion spans have mask=1
+        split = cmt._completion_spans[0][0]
+        for (start, end) in cmt._completion_spans:
+            for i in range(start - split, min(end - split, len(sample.response_loss_mask))):
+                assert sample.response_loss_mask[i] == 1, \
+                    f"Expected mask=1 at response position {i}"
+
+        # Check: between completions (env + gen_prompt), mask=0
+        span1_end = cmt._completion_spans[0][1] - split
+        span2_start = cmt._completion_spans[1][0] - split
+        for i in range(span1_end, span2_start):
+            assert sample.response_loss_mask[i] == 0, \
+                f"Expected mask=0 at env/header position {i}"
+
+    def test_logprobs_are_server_values(self):
